# Application
PORT=3000
# Retry-After (seconds) of a 503 answer
HTTP_RETRY_AFTER_SECONDS=2
# Backoff of a PENDING_REFERENCE transaction waiting for its reference
PENDING_REFERENCE_BACKOFF_BASE_MS=2000
PENDING_REFERENCE_BACKOFF_CAP_MS=60000
PENDING_REFERENCE_MAX_ATTEMPTS=8

# docker compose (host ports are configurable to avoid clashes with other stacks)
POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering
POSTGRES_DB=wagering
POSTGRES_HOST_PORT=55432
LOCALSTACK_HOST_PORT=4566

# SQS (LocalStack accepts any static credentials)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Defaults to http://localhost:${LOCALSTACK_HOST_PORT}. Set it only to point at another SQS endpoint.
# SQS_ENDPOINT=http://localhost:4566

# Tests
RERUN_EACH=20
KEEP_TEST_DATABASES=0
