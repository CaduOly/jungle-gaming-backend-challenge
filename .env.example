# Application
PORT=3000

# PostgreSQL (when DATABASE_URL is empty it is composed from the POSTGRES_* variables below)
DATABASE_URL=postgres://wagering:wagering@localhost:55432/wagering
# SET LOCAL lock_timeout of every unit of work
DB_LOCK_TIMEOUT_MS=2000
# Wait for a pooled connection before failing with a transient error (never hang on an exhausted pool)
DB_POOL_ACQUIRE_TIMEOUT_MS=5000

# docker compose (host ports are configurable to avoid clashes with other stacks)
POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering
POSTGRES_DB=wagering
POSTGRES_HOST_PORT=55432
LOCALSTACK_HOST_PORT=4566

# SQS (LocalStack accepts any static credentials)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Defaults to http://localhost:${LOCALSTACK_HOST_PORT}. Set it only to point at another SQS endpoint.
# SQS_ENDPOINT=http://localhost:4566
SQS_MAX_ATTEMPTS=3
# SQS_EVENTS_QUEUE_URL wins over the name, which is resolved with GetQueueUrl
SQS_EVENTS_QUEUE_URL=
SQS_EVENTS_QUEUE_NAME=wagering-events.fifo
SQS_COMMANDS_QUEUE_URL=
SQS_COMMANDS_QUEUE_NAME=wagering-commands.fifo
SQS_COMMANDS_DLQ_URL=
SQS_COMMANDS_DLQ_NAME=wagering-commands-dlq.fifo

# SQS consumer (heartbeat must be shorter than the visibility timeout)
SQS_CONSUMER_WAIT_TIME_SECONDS=20
SQS_CONSUMER_MAX_MESSAGES=10
SQS_CONSUMER_VISIBILITY_TIMEOUT_SECONDS=30
SQS_CONSUMER_HEARTBEAT_INTERVAL_MS=10000
# Same value as the queues' redrive policy (infra/localstack/init-sqs.sh)
SQS_MAX_RECEIVE_COUNT=5
SQS_CONSUMER_RETRY_BASE_MS=1000
SQS_CONSUMER_RETRY_CAP_MS=60000
SQS_CONSUMER_ERROR_DELAY_MS=1000
SHUTDOWN_TIMEOUT_MS=25000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_OPEN_MS=5000

# Outbox publisher
OUTBOX_LEASE_MS=30000
OUTBOX_BATCH_SIZE=10
OUTBOX_POLL_INTERVAL_MS=200
# OUTBOX_LEASE_MS must exceed OUTBOX_BATCH_SIZE x OUTBOX_PUBLISH_TIMEOUT_MS
OUTBOX_PUBLISH_TIMEOUT_MS=2000
OUTBOX_BACKOFF_BASE_MS=500
OUTBOX_BACKOFF_CAP_MS=60000
OUTBOX_MAX_ATTEMPTS=10

# Pending reference worker (PENDING_REFERENCE retries). The backoff (base 2s, cap 60s, 8 attempts: about
# 5 minutes before REFERENCE_NOT_FOUND) is also the one the HTTP/SQS flow uses to schedule the first retry.
PENDING_BATCH_SIZE=10
# PENDING_LEASE_MS must exceed PENDING_BATCH_SIZE x 2 x DB_LOCK_TIMEOUT_MS
PENDING_LEASE_MS=60000
PENDING_POLL_INTERVAL_MS=1000
PENDING_BACKOFF_BASE_MS=2000
PENDING_BACKOFF_CAP_MS=60000
PENDING_MAX_ATTEMPTS=8

# Tests
RERUN_EACH=20
KEEP_TEST_DATABASES=0
# Test-only failure points (comma separated: fail_outbox_insert, crash_after_publish_before_mark,
# crash_after_commit_before_ack, slow_handler). Leave empty in production.
FAULT_INJECTION=
FAULT_SLOW_HANDLER_MS=2000
