# Aplicação
PORT=3000
# Papéis deste processo (separados por vírgula; vazio = todos): api, consumer, outbox, pending-worker
APP_ROLES=api,consumer,outbox,pending-worker
# Nome da réplica no X-Instance-Id, no /health/ready e nos logs (padrão: host-pid)
INSTANCE_ID=
# Limite (ms) de uma requisição HTTP; passou disso a resposta é 503 + Retry-After (as escritas são idempotentes)
HTTP_REQUEST_TIMEOUT_MS=10000
# Porta no host do nginx que fica na frente das réplicas (docker compose up)
APP_HOST_PORT=8080
# Nível do pino: fatal, error, warn, info, debug, trace ou silent
LOG_LEVEL=info
# Retry-After (segundos) de uma resposta 503
HTTP_RETRY_AFTER_SECONDS=2
# Maior body JSON aceito (b, kb ou mb); acima disso responde 413
HTTP_BODY_LIMIT=100kb
# Limite (ms) de cada checagem do /health/ready (PostgreSQL SELECT 1, SQS GetQueueAttributes)
HEALTH_READINESS_TIMEOUT_MS=1000

# PostgreSQL (com DATABASE_URL vazio ele é montado a partir das variáveis POSTGRES_* abaixo)
DATABASE_URL=postgres://wagering:wagering@localhost:55432/wagering
# SET LOCAL lock_timeout de toda unit of work
DB_LOCK_TIMEOUT_MS=2000
# Espera por uma conexão do pool antes de falhar com erro transiente (nunca trava num pool esgotado)
DB_POOL_ACQUIRE_TIMEOUT_MS=5000

# docker compose (as portas no host são configuráveis para não bater com outras stacks)
POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering
POSTGRES_DB=wagering
POSTGRES_HOST_PORT=55432
LOCALSTACK_HOST_PORT=4566

# SQS (o LocalStack aceita qualquer credencial estática)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Endpoint do LocalStack para a aplicação rodando fora do Docker. Sem ele o SDK procura o SQS da AWS.
# Segue a LOCALSTACK_HOST_PORT, então mudar a porta lá já basta.
SQS_ENDPOINT=http://localhost:${LOCALSTACK_HOST_PORT}
SQS_MAX_ATTEMPTS=3
# SQS_EVENTS_QUEUE_URL tem prioridade sobre o nome, que é resolvido com GetQueueUrl
SQS_EVENTS_QUEUE_URL=
SQS_EVENTS_QUEUE_NAME=wagering-events.fifo
SQS_COMMANDS_QUEUE_URL=
SQS_COMMANDS_QUEUE_NAME=wager-transactions.fifo
SQS_COMMANDS_DLQ_URL=
SQS_COMMANDS_DLQ_NAME=wager-transactions-dlq.fifo

# Consumer SQS (o heartbeat tem de ser menor que o visibility timeout)
SQS_CONSUMER_WAIT_TIME_SECONDS=20
SQS_CONSUMER_MAX_MESSAGES=10
SQS_CONSUMER_VISIBILITY_TIMEOUT_SECONDS=30
SQS_CONSUMER_HEARTBEAT_INTERVAL_MS=10000
# Redrive das filas (infra/localstack/init-sqs.sh): é só uma rede para um consumer que cai antes de liquidar a mensagem.
# Ele conta entregas, não falhas, então fica bem acima do limite de retry abaixo.
SQS_MAX_RECEIVE_COUNT=100
# O limite de retry: falhas da própria mensagem, repetidas no processo, antes da DLQ explícita
SQS_CONSUMER_MAX_IN_PROCESS_ATTEMPTS=8
SQS_CONSUMER_RETRY_BASE_MS=1000
SQS_CONSUMER_RETRY_CAP_MS=60000
SQS_CONSUMER_ERROR_DELAY_MS=1000
SHUTDOWN_TIMEOUT_MS=25000
# Limite (ms) de uma tentativa do handler; passou disso a tentativa é repetida como falha transiente
SQS_CONSUMER_HANDLER_TIMEOUT_MS=15000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_OPEN_MS=5000

# Publisher do outbox
OUTBOX_LEASE_MS=30000
OUTBOX_BATCH_SIZE=10
OUTBOX_POLL_INTERVAL_MS=200
# OUTBOX_LEASE_MS tem de ser maior que OUTBOX_BATCH_SIZE x OUTBOX_PUBLISH_TIMEOUT_MS
OUTBOX_PUBLISH_TIMEOUT_MS=2000
OUTBOX_BACKOFF_BASE_MS=500
OUTBOX_BACKOFF_CAP_MS=60000
OUTBOX_MAX_ATTEMPTS=10

# Worker de referência pendente (retries de PENDING_REFERENCE). O backoff (base 2s, teto 60s, 8 tentativas: uns
# 5 minutos até REFERENCE_NOT_FOUND) é o mesmo que o fluxo HTTP/SQS usa para agendar o primeiro retry.
PENDING_BATCH_SIZE=10
# PENDING_LEASE_MS tem de ser maior que PENDING_BATCH_SIZE x 2 x DB_LOCK_TIMEOUT_MS
PENDING_LEASE_MS=60000
PENDING_POLL_INTERVAL_MS=1000
PENDING_BACKOFF_BASE_MS=2000
PENDING_BACKOFF_CAP_MS=60000
PENDING_MAX_ATTEMPTS=8

# Testes
RERUN_EACH=20
KEEP_TEST_DATABASES=0
# Pontos de falha só para teste (separados por vírgula: fail_outbox_insert, crash_after_publish_before_mark,
# crash_after_commit_before_ack, slow_handler). Deixe vazio em produção.
FAULT_INJECTION=
FAULT_SLOW_HANDLER_MS=2000

# Stack de observabilidade (sobe junto no docker compose up)
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin

# Autenticação do provider. jwks (padrão): tokens client_credentials do Keycloak, verificados com jose, como em
# produção. noop: pula o IdP, aceita `Authorization: Bearer dev:<providerId>` e não prova nada. Só para dev.
AUTH_MODE=jwks
# Usado pelo `bun run start:dev`, que roda no host; dentro do compose as réplicas usam http://keycloak:8080
AUTH_JWKS_URL=http://localhost:8081/realms/wagering/protocol/openid-connect/certs
# O `iss` dos tokens: o Keycloak fixa ele no KC_HOSTNAME, a URL que os providers usam
AUTH_ISSUER=http://localhost:8081/realms/wagering
AUTH_AUDIENCE=wagering-api
KEYCLOAK_HOST_PORT=8081
KEYCLOAK_ADMIN_PASSWORD=admin
