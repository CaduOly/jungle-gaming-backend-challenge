# Application
PORT=3000

# PostgreSQL (when DATABASE_URL is empty it is composed from the POSTGRES_* variables below)
DATABASE_URL=postgres://wagering:wagering@localhost:55432/wagering
# SET LOCAL lock_timeout of every unit of work
DB_LOCK_TIMEOUT_MS=2000
# Wait for a pooled connection before failing with a transient error (never hang on an exhausted pool)
DB_POOL_ACQUIRE_TIMEOUT_MS=5000

# docker compose (host ports are configurable to avoid clashes with other stacks)
POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering
POSTGRES_DB=wagering
POSTGRES_HOST_PORT=55432
LOCALSTACK_HOST_PORT=4566

# SQS (LocalStack accepts any static credentials)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566

# Tests
RERUN_EACH=20
KEEP_TEST_DATABASES=0
# Test-only failure points (comma separated, e.g. fail_outbox_insert). Leave empty in production.
FAULT_INJECTION=
